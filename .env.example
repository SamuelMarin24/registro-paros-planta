# Copia este archivo como `.env` y completa los valores de tu entorno.
# El archivo `.env` NUNCA se sube al repositorio (está en .gitignore).

# ── Base de datos (origen de las órdenes de producción) ──
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=produccion
SQL_USER=usuario_lectura
SQL_PASSWORD=tu_password_aqui
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TABLA_ORDENES=ordenes_produccion

# ── Rutas de archivos (locales o en carpeta de red) ──
RUTA_MAESTRAS=datos/maestras.xlsx
RUTA_RAZONES=datos/razones_de_paro.xlsx
RUTA_CONSOLIDADO=datos/registros.xlsx
HOJA_OPERARIOS=OPERARIOS

# ── Control de acceso: áreas autorizadas para iniciar sesión ──
AREAS_LOGIN=ANALITICA,SUPERVISION

# ── Operación ──
INTERVALO_RECARGA_MIN=60
PUERTO_APP=5002
